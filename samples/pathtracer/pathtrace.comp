#version 460
#extension GL_EXT_ray_query : require

#define GFX_BINDLESS_RAY_TRACING
#include "pt_shared.h"
#include "gfx_bindless.h"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0) uniform Globals
{
    FrameData frame;
};

layout(push_constant) uniform PushConstant
{
    TraceConstants pc;
};

const float PI = 3.14159265359;
const float MAX_RAY_DIST = 1000.0;
const float RAY_OFFSET = 0.001;
const float SUN_CONE_ANGLE = 0.005;
const int MAX_BOUNCES = 16;
const int RUSSIAN_ROULETTE_BOUNCE = 4;
const float MIN_DOT = 0.0001;
const float MIN_ROUGHNESS = 0.05;
const float MAX_INDIRECT_LUMINANCE = 10.0;
const vec3 LUMINANCE_WEIGHTS = vec3(0.2126, 0.7152, 0.0722);
const vec3 SKY_HORIZON = vec3(0.0);
const vec3 SKY_ZENITH = vec3(0.0);

struct Hit
{
    bool hit;
    float t;
    uint instance;
    uint primitive;
    vec2 barycentrics;
    mat4x3 object_to_world;
    mat4x3 world_to_object;
};

struct Surface
{
    vec3 geometric_normal;
    vec3 shading_normal;
    vec3 albedo;
    vec3 emissive;
    float metallic;
    float roughness;
    float transmission;
    float ior;
    bool front_face;
};

uint PcgHash(uint value)
{
    const uint state = value * 747796405u + 2891336453u;
    const uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float RandomFloat(inout uint state)
{
    state = PcgHash(state);
    return float(state) * 2.3283064365386963e-10;
}

vec2 RandomVec2(inout uint state)
{
    return vec2(RandomFloat(state), RandomFloat(state));
}

float Halton(uint index, uint base)
{
    float f = 1.0;
    float r = 0.0;
    while (index > 0u)
    {
        f = f / float(base);
        r = r + f * float(index % base);
        index = index / base;
    }
    return r;
}

uvec3 ReadTriangle(Mesh mesh, uint primitive)
{
    const uint first = primitive * 3;
    return uvec3(mesh.indices.values[first], mesh.indices.values[first + 1], mesh.indices.values[first + 2]);
}

vec3 ReadVec3(Floats values, uint index)
{
    return vec3(values.values[index * 3], values.values[index * 3 + 1], values.values[index * 3 + 2]);
}

vec2 ReadVec2(Floats values, uint index)
{
    return vec2(values.values[index * 2], values.values[index * 2 + 1]);
}

vec3 Weights(vec2 barycentrics)
{
    return vec3(1.0 - barycentrics.x - barycentrics.y, barycentrics.x, barycentrics.y);
}

vec2 InterpolateUv(Mesh mesh, uvec3 triangle, vec3 weights)
{
    return ReadVec2(mesh.uvs, triangle.x) * weights.x + ReadVec2(mesh.uvs, triangle.y) * weights.y + ReadVec2(mesh.uvs, triangle.z) * weights.z;
}

bool IsOpaque(rayQueryEXT query)
{
    Mesh mesh = pc.meshes.values[rayQueryGetIntersectionInstanceCustomIndexEXT(query, false)];
    const uvec3 triangle = ReadTriangle(mesh, rayQueryGetIntersectionPrimitiveIndexEXT(query, false));
    const vec2 uv = InterpolateUv(mesh, triangle, Weights(rayQueryGetIntersectionBarycentricsEXT(query, false)));
    const float alpha = mesh.albedo.a * textureLod(textures_2d[nonuniformEXT(mesh.albedo_index)], uv, 0.0).a;
    return alpha >= mesh.alpha_cutoff;
}

Hit TraceScene(vec3 origin, vec3 direction, float max_distance)
{
    rayQueryEXT query;
    rayQueryInitializeEXT(query, tlas[pc.tlas_index], gl_RayFlagsNoneEXT, 0xFF, origin, 0.0, direction, max_distance);
    while (rayQueryProceedEXT(query))
    {
        if (IsOpaque(query))
            rayQueryConfirmIntersectionEXT(query);
    }

    Hit hit;
    hit.hit = rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
    if (hit.hit)
    {
        hit.t = rayQueryGetIntersectionTEXT(query, true);
        hit.instance = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
        hit.primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        hit.barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
        hit.object_to_world = rayQueryGetIntersectionObjectToWorldEXT(query, true);
        hit.world_to_object = rayQueryGetIntersectionWorldToObjectEXT(query, true);
    }
    return hit;
}

bool IsVisible(vec3 origin, vec3 direction, float max_distance)
{
    rayQueryEXT query;
    rayQueryInitializeEXT(query, tlas[pc.tlas_index], gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, origin, 0.0, direction, max_distance);
    while (rayQueryProceedEXT(query))
    {
        if (IsOpaque(query))
            rayQueryConfirmIntersectionEXT(query);
    }
    return rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT;
}

Surface GetSurface(Hit hit, vec3 direction)
{
    Mesh mesh = pc.meshes.values[hit.instance];
    const uvec3 triangle = ReadTriangle(mesh, hit.primitive);
    const vec3 weights = Weights(hit.barycentrics);

    const vec3 p0 = hit.object_to_world * vec4(ReadVec3(mesh.positions, triangle.x), 1.0);
    const vec3 p1 = hit.object_to_world * vec4(ReadVec3(mesh.positions, triangle.y), 1.0);
    const vec3 p2 = hit.object_to_world * vec4(ReadVec3(mesh.positions, triangle.z), 1.0);
    vec3 geometric_normal = normalize(cross(p1 - p0, p2 - p0));

    const vec3 object_normal = ReadVec3(mesh.normals, triangle.x) * weights.x + ReadVec3(mesh.normals, triangle.y) * weights.y + ReadVec3(mesh.normals, triangle.z) * weights.z;
    vec3 shading_normal = normalize(vec3(object_normal * hit.world_to_object));
    const bool front_face = dot(shading_normal, direction) < 0.0;

    if (dot(geometric_normal, direction) > 0.0)
        geometric_normal = -geometric_normal;
    if (dot(shading_normal, geometric_normal) < 0.0)
        shading_normal = -shading_normal;

    const vec2 uv = InterpolateUv(mesh, triangle, weights);
    const vec4 texel = textureLod(textures_2d[nonuniformEXT(mesh.albedo_index)], uv, 0.0);

    Surface surface;
    surface.geometric_normal = geometric_normal;
    surface.shading_normal = shading_normal;
    surface.albedo = mesh.albedo.rgb * texel.rgb;
    surface.emissive = mesh.emissive.rgb;
    surface.metallic = mesh.metallic;
    surface.roughness = max(mesh.roughness, MIN_ROUGHNESS);
    surface.transmission = mesh.transmission;
    surface.ior = mesh.ior;
    surface.front_face = front_face;
    return surface;
}

bool IsEmissive(Surface surface)
{
    return max(max(surface.emissive.r, surface.emissive.g), surface.emissive.b) > 0.0;
}

vec3 SampleSkyColor(vec3 direction)
{
    return mix(SKY_HORIZON, SKY_ZENITH, clamp(direction.y, 0.0, 1.0));
}

mat3 GetTangentSpace(vec3 normal)
{
    const float s = normal.z >= 0.0 ? 1.0 : -1.0;
    const float a = -1.0 / (s + normal.z);
    const float b = normal.x * normal.y * a;
    const vec3 tangent = vec3(1.0 + s * normal.x * normal.x * a, s * b, -s * normal.x);
    const vec3 bitangent = vec3(b, s + normal.y * normal.y * a, -normal.y);
    return mat3(tangent, bitangent, normal);
}

vec3 SampleSunCone(float cone_angle, vec2 rand)
{
    const float cos_theta = mix(1.0, cos(cone_angle), rand.x);
    const float sin_theta = sqrt(1.0 - cos_theta * cos_theta);
    const float phi = 2.0 * PI * rand.y;
    const vec3 local_dir = vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);
    return normalize(GetTangentSpace(frame.sun_direction.xyz) * local_dir);
}

vec3 SampleCosineHemisphere(vec2 rand)
{
    const float radius = sqrt(rand.x);
    const float phi = 2.0 * PI * rand.y;
    return vec3(radius * cos(phi), radius * sin(phi), sqrt(max(1.0 - rand.x, 0.0)));
}

vec3 SampleGGXHalfVector(vec2 rand, float alpha)
{
    const float phi = 2.0 * PI * rand.x;
    const float cos_theta = sqrt((1.0 - rand.y) / (1.0 + (alpha * alpha - 1.0) * rand.y));
    const float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
    return vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);
}

vec3 MaterialF0(vec3 albedo, float metallic)
{
    return mix(vec3(0.04), albedo, metallic);
}

vec3 FresnelSchlickRoughness(float cos_theta, vec3 f0, float roughness)
{
    return f0 + (max(vec3(1.0 - roughness), f0) - f0) * pow(clamp(1.0 - cos_theta, 0.0, 1.0), 5.0);
}

float DielectricFresnel(float cos_i, float eta)
{
    const float sin2_t = eta * eta * (1.0 - cos_i * cos_i);
    if (sin2_t >= 1.0)
        return 1.0;

    const float cos_t = sqrt(1.0 - sin2_t);
    const float rs = (eta * cos_i - cos_t) / (eta * cos_i + cos_t);
    const float rp = (cos_i - eta * cos_t) / (cos_i + eta * cos_t);
    return 0.5 * (rs * rs + rp * rp);
}

float DistributionGGX(float NdotH, float roughness)
{
    const float alpha = roughness * roughness;
    const float alpha2 = alpha * alpha;
    const float denominator = NdotH * NdotH * (alpha2 - 1.0) + 1.0;
    return alpha2 / (PI * denominator * denominator);
}

float GeometrySchlickGGX(float NdotX, float roughness)
{
    const float r = roughness + 1.0;
    const float k = r * r / 8.0;
    return NdotX / (NdotX * (1.0 - k) + k);
}

float GeometrySmith(float NdotV, float NdotL, float roughness)
{
    return GeometrySchlickGGX(NdotV, roughness) * GeometrySchlickGGX(NdotL, roughness);
}

vec3 ClampContribution(vec3 contribution, int bounce)
{
    const float luminance = dot(contribution, LUMINANCE_WEIGHTS);
    if (bounce == 0 || luminance <= MAX_INDIRECT_LUMINANCE)
        return contribution;

    return contribution * (MAX_INDIRECT_LUMINANCE / luminance);
}

vec3 TracePath(inout uint rng_state, vec3 origin, vec3 dir)
{
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    vec3 pos = origin;

    for (int i = 0; i < MAX_BOUNCES; ++i)
    {
        const Hit hit = TraceScene(pos, dir, MAX_RAY_DIST);
        if (!hit.hit)
        {
            radiance += ClampContribution(SampleSkyColor(dir) * throughput, i);
            break;
        }

        const Surface surface = GetSurface(hit, dir);
        if (IsEmissive(surface))
        {
            radiance += ClampContribution(surface.emissive * throughput, i);
            break;
        }

        if (RandomFloat(rng_state) < surface.transmission)
        {
            const vec3 hit_position = pos + hit.t * dir;
            const float eta = surface.front_face ? 1.0 / surface.ior : surface.ior;
            const vec3 refracted = refract(dir, surface.shading_normal, eta);
            const float reflectance = DielectricFresnel(max(dot(surface.shading_normal, -dir), MIN_DOT), eta);
            if (all(equal(refracted, vec3(0.0))) || RandomFloat(rng_state) < reflectance)
            {
                dir = reflect(dir, surface.shading_normal);
                pos = hit_position + surface.geometric_normal * RAY_OFFSET;
            }
            else
            {
                dir = refracted;
                pos = hit_position - surface.geometric_normal * RAY_OFFSET;
                throughput *= surface.albedo;
            }
            continue;
        }

        const vec3 N = surface.shading_normal;
        const vec3 V = -dir;
        const float NdotV = max(dot(N, V), MIN_DOT);

        const vec3 F0 = MaterialF0(surface.albedo, surface.metallic);
        const vec3 F = FresnelSchlickRoughness(NdotV, F0, surface.roughness);
        const vec3 kD = (1.0 - F) * (1.0 - surface.metallic);
        const float specular_prob = clamp((F.r + F.g + F.b) / 3.0, 0.2, 0.95);

        const mat3 tbn = GetTangentSpace(N);
        pos = pos + hit.t * dir + surface.geometric_normal * RAY_OFFSET;

        const vec3 sun_dir = SampleSunCone(SUN_CONE_ANGLE, RandomVec2(rng_state));
        const float NdotL_sun = dot(N, sun_dir);
        if (NdotL_sun > 0.0 && dot(surface.geometric_normal, sun_dir) > 0.0 && IsVisible(pos, sun_dir, MAX_RAY_DIST))
        {
            const vec3 H_sun = normalize(V + sun_dir);
            const float NdotH_sun = max(dot(N, H_sun), MIN_DOT);

            const vec3 sun_diffuse = surface.albedo / PI * kD;
            const float D_sun = DistributionGGX(NdotH_sun, surface.roughness);
            const float G_sun = GeometrySmith(NdotV, NdotL_sun, surface.roughness);
            const vec3 sun_specular = D_sun * G_sun * F / (4.0 * NdotV * NdotL_sun + MIN_DOT);

            radiance += ClampContribution(throughput * (sun_diffuse + sun_specular) * frame.sun_color.rgb * NdotL_sun, i);
        }

        const vec2 bounce_rand = RandomVec2(rng_state);
        vec3 brdf_weight;
        if (RandomFloat(rng_state) < specular_prob)
        {
            const float alpha = max(surface.roughness * surface.roughness, 0.001);
            const vec3 H = normalize(tbn * SampleGGXHalfVector(bounce_rand, alpha));
            dir = normalize(reflect(-V, H));

            const float NdotL = max(dot(N, dir), MIN_DOT);
            const float NdotH = max(dot(N, H), MIN_DOT);
            const float VdotH = max(dot(V, H), MIN_DOT);
            const float G = GeometrySmith(NdotV, NdotL, surface.roughness);

            brdf_weight = F * G * VdotH / (NdotV * NdotH * specular_prob);
        }
        else
        {
            dir = normalize(tbn * SampleCosineHemisphere(bounce_rand));
            brdf_weight = surface.albedo * kD / (1.0 - specular_prob);
        }

        if (dot(surface.geometric_normal, dir) <= 0.0)
            break;

        throughput *= brdf_weight;

        if (i >= RUSSIAN_ROULETTE_BOUNCE)
        {
            const float intensity = max(max(throughput.r, throughput.g), throughput.b);
            if (RandomFloat(rng_state) > intensity)
                break;

            throughput /= intensity;
        }
    }

    return radiance;
}

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(images_2d[pc.radiance_index]);
    if (any(greaterThanEqual(pixel, size)))
        return;

    const uint pixel_seed = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u;
    uint offset_rng_state = PcgHash(pixel_seed);
    const vec2 halton_offset = RandomVec2(offset_rng_state);
    const vec2 xi = fract(vec2(Halton(frame.frame_index + 1u, 2u), Halton(frame.frame_index + 1u, 3u)) + halton_offset);

    uint rng_state = PcgHash(pixel_seed + frame.frame_index * 26699u);

    const vec2 ndc = (vec2(pixel) + xi) * frame.pixel_size.xy * 2.0 - 1.0;
    const vec3 ray_dir = normalize(frame.forward.xyz + ndc.x * frame.right.xyz - ndc.y * frame.up.xyz);

    vec3 color = TracePath(rng_state, frame.position.xyz, ray_dir);
    if (any(isnan(color)) || any(isinf(color)))
        color = vec3(0.0);

    const vec3 previous = imageLoad(images_2d[pc.radiance_index], pixel).rgb;
    const float blend_weight = 1.0 / float(clamp(frame.sample_count, 1u, pc.history_limit));
    imageStore(images_2d[pc.radiance_index], pixel, vec4(mix(previous, color, blend_weight), 1.0));
}
